{
  "type": "object",
  "description": "Display Info",
  "required": [
    "device_name",
    "desktop_coordinates",
    "resolutions",
    "attached_to_desktop",
    "rotation"
  ],
  "properties": {
    "attached_to_desktop": {
      "type": "boolean",
      "description": "Is the display attached to the desktop"
    },
    "desktop_coordinates": {
      "description": "Display device rect coordinates on the desktop",
      "type": "object",
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "bottom": {
          "type": "integer",
          "format": "int32",
          "description": "Bottom coordinate of the rectangle"
        },
        "left": {
          "type": "integer",
          "format": "int32",
          "description": "Left coordinate of the rectangle"
        },
        "right": {
          "type": "integer",
          "format": "int32",
          "description": "Right coordinate of the rectangle"
        },
        "top": {
          "type": "integer",
          "format": "int32",
          "description": "Top coordinate of the rectangle"
        }
      },
      "x-readme-ref-name": "DisplayRect"
    },
    "device_name": {
      "type": "string",
      "description": "Display device name, e.g. \"\\\\.\\DISPLAY1\""
    },
    "display_device_name": {
      "type": ["string", "null"],
      "description": "Display device friendly name, e.g. \"Generic PnP Monitor\""
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "Resolution Struct",
        "required": ["width", "height"],
        "properties": {
          "height": {
            "type": "integer",
            "format": "int32",
            "description": "Height of the resolution in pixels",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "format": "int32",
            "description": "Width of the resolution in pixels",
            "minimum": 0
          }
        },
        "x-readme-ref-name": "Resolution"
      },
      "description": "Supported display resolutions (width, height)"
    },
    "rotation": {
      "type": "integer",
      "format": "int32",
      "description": "Display rotation angle in degrees, e.g. 0, 90, 180, 270"
    }
  },
  "x-readme-ref-name": "DisplayInfo"
}
