        "required": ["connection_id", "version_info"],
        "properties": {
          "connection_id": { "type": "string", "description": "Connection ID" },
          "ip": {
            "type": ["string", "null"],
            "description": "IP address of the connection"
          },
          "version_info": {
            "description": "Version info of the connection",
            "type": "object",
            "required": [
