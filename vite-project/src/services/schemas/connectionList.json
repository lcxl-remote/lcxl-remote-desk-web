              "build_number",
              "commit_hash",
              "remote_desk_type",
              "operation_system"
            ],
            "properties": {
              "api_version": {
                "type": "integer",
                "format": "int32",
                "description": "The version of the API. This is a simple integer that increments when API is changed."
              },
              "build_number": {
                "type": "integer",
                "format": "int32",
                "description": "The build number of the server."
              },
              "client_id": {
                "type": ["string", "null"],
                "description": "Client ID of the server."
              },
              "commit_hash": {
                "type": "string",
                "description": "The commit hash of the server."
              },
              "display_name": {
                "type": ["string", "null"],
                "description": "Display name of the remote desk."
              },
              "operation_system": {
                "description": "Operation system associated with the version.",
                "type": "string",
                "enum": [
                  "Windows",
                  "Linux",
                  "Mac",
                  "Android",
                  "Ios",
                  "Web",
                  "Other"
                ],
                "x-readme-ref-name": "OperationSystemEnum"
              },
              "remote_desk_type": {
                "description": "Remote desk type associated with the version.",
                "type": "string",
                "enum": ["browser", "server", "signal", "manager"],
                "x-readme-ref-name": "RemoteDeskTypeEnum"
              },
              "token": {
                "type": ["string", "null"],
                "description": "Authentication token for server nodes or API clients."
              }
            },
            "x-readme-ref-name": "VersionInfo"
          }
        },
        "x-readme-ref-name": "ConnectionModel"
