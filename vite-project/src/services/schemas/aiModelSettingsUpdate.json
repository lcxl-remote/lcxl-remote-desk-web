        }
      ]
    },
    "max_context_bytes": {
      "type": ["integer", "null"],
      "format": "int64",
      "minimum": 0
    },
    "model": { "type": ["string", "null"] },
    "provider": { "type": ["string", "null"] },
    "response_format": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "description": "`None` leaves the stored mode unchanged.",
          "enum": ["none", "json_object", "json_schema"],
          "x-readme-ref-name": "ResponseFormatMode"
        }
      ]
