{
  "type": "object",
  "required": [
    "software",
    "uptime",
    "interfaces",
    "port_capacity",
    "port_allocated"
  ],
  "properties": {
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["transport", "listen", "external"],
        "properties": {
          "external": {
            "type": "string",
            "description": "external address\n\nspecify the node external address and port.\nfor the case of exposing the service to the outside,\nyou need to manually specify the server external IP\naddress and service listening port."
          },
          "listen": {
            "type": "string",
            "description": "turn server listen address"
          },
          "transport": {
            "type": "string",
            "enum": ["tcp", "udp"],
            "x-readme-ref-name": "TurnTransport"
          }
        },
        "x-readme-ref-name": "TurnInterface"
      }
    },
    "port_allocated": { "type": "integer", "minimum": 0 },
    "port_capacity": { "type": "integer", "minimum": 0 },
    "software": { "type": "string" },
    "uptime": { "type": "integer", "format": "int64", "minimum": 0 }
  },
  "x-readme-ref-name": "TurnInfo"
}
